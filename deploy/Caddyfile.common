(xdrive_app) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	@pwa_static path /sw.js /site.webmanifest /offline.html
	header @pwa_static Cache-Control "no-cache, must-revalidate"
	@pwa_document path / /index.html
	header @pwa_document Cache-Control "no-cache, must-revalidate"
	# Never forward JSAPI requests directly to Baidu or the SPA fallback.
	# Go enforces signed release, Cookie, Owner, fixed upstream and resource policy.
	handle /_BMapService/* {
		header Cache-Control "private, no-store"
		header Referrer-Policy "no-referrer"
		header X-Content-Type-Options "nosniff"
		reverse_proxy server:8080
	}
	# A public certificate (never a private key) is readable only at this
	# fixed path. Desktop consumes it exclusively through an independently
	# validated public-domain TLS connection with direct LAN-IP dialing.
	# Fetching this over the untrusted IP origin grants NO trust whatsoever.
	handle /_xdrive/desktop/lan-root.crt {
		header Cache-Control "private, no-store"
		header Referrer-Policy "no-referrer"
		header X-Content-Type-Options "nosniff"
		header Content-Type "application/x-pem-file"
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}

	handle /api/* {
		reverse_proxy server:8080
	}
	# Missing hashed bundles must return real 404, never SPA HTML.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
		format console
	}
}
