(xdrive_app) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	@pwa_static path /sw.js /site.webmanifest /offline.html
	header @pwa_static Cache-Control "no-cache, must-revalidate"
	# Never forward JSAPI requests directly to Baidu or the SPA fallback.
	# Go enforces signed release, Cookie, Owner, fixed upstream and resource policy.
	handle /_BMapService/* {
		header Cache-Control "private, no-store"
		header Referrer-Policy "no-referrer"
		header X-Content-Type-Options "nosniff"
		reverse_proxy server:8080
	}
	handle /api/* {
		reverse_proxy server:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
		format console
	}
}
