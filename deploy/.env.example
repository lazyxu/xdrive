# xDrive server environment. The installer writes the active file to ~/.xd/config/.env.
POSTGRES_PASSWORD=replace-with-random-value
XD_JWT_SECRET=replace-with-a-long-random-value
# External connector credentials use an independent versioned encryption keyring.
# Format: VERSION:64_HEX[,VERSION:64_HEX...]
XD_CONNECTOR_SECRET_ACTIVE_VERSION=1
XD_CONNECTOR_SECRET_KEYS=1:replace-with-64-hex-characters
# Legacy single-key input is accepted for migration only.
XD_CONNECTOR_SECRET_KEY=
XD_ACCESS_TOKEN_TTL=15m
XD_REFRESH_TOKEN_TTL=720h
# Server-side pull connectors run immediately at worker start, then on this interval.
XD_SOURCE_PULL_INTERVAL=6h
# Worker checks for due Sources frequently, but each Source is scanned only
# after XD_SOURCE_PULL_INTERVAL has elapsed since its previous run.
XD_SOURCE_WORKER_POLL_INTERVAL=1m
# Normally leave this at the Compose-internal API address.
XD_INTERNAL_SERVER_URL=http://server:8080
# Direct HTTP/private-mode entry point served by the Caddy/Web edge container.
XD_WEB_BIND=127.0.0.1
XD_WEB_PORT=3000
XD_ALLOWED_ORIGIN=http://localhost:3000
XD_MAX_UPLOAD_BYTES=21474836480

# Optional Baidu Maps Server Static API (the only Gallery map provider).
# You may also enter/change the AK in Admin → 服务与依赖 without restarting.
# After an admin save, the AES-GCM encrypted PostgreSQL setting overrides these values.
XD_BAIDU_MAP_ENABLED=false
XD_BAIDU_MAP_AK=

# Optional GeoNames immutable historical snapshots. Requires a trusted,
# persistent, Server-writable directory provisioned by the operator inside
# the existing /data mount (e.g. /data/.xdrive-geonames-snapshots).
# Keep this blank until permissions/storage are prepared. Data source remains
# the deployment-only, read-only /geonames mount. This is NOT dataset apply.
XD_GEONAMES_SNAPSHOT_DIR=

# Optional xDrive Photo Intelligence local analyzer (face + lexical/semantic Gallery Smart Search).
# Leave COMPOSE_PROFILES empty to keep the analyzer disabled.
# To enable: set COMPOSE_PROFILES=photo-intelligence and point the Server at
# the shared Unix socket below. The analyzer receives only short-lived signed
# analysis-preview URLs; it does not mount the xDrive file store.
COMPOSE_PROFILES=
XD_PHOTO_FACE_ANALYZER_SOCKET=
XD_PHOTO_FACE_ANALYZER_TOKEN=
XD_PHOTO_FACE_PREVIEW_BASE_URL=http://server:8080
XD_PHOTO_FACE_RUNTIME_DIR=
# Update provider and release channel used by xdrive-server update.
# GitLab defaults to http://gitlab.t-fluid.com:1080/xuliang/xdrive.
XD_UPDATE_SOURCE=github
XD_RELEASE_CHANNEL=stable
XD_RELEASE_COMMIT=

# Host layout / Docker mode. The installer resolves these automatically.
# XD_DOCKER_MODE is rootful or rootless. The default data directories are
# ~/.xd/data/files, ~/.xd/data/postgres and ~/.xd/data/caddy/{data,config}.
XD_DOCKER_MODE=
XD_SERVER_UID=65532
XD_SERVER_GID=65532
XD_FILES_DATA_DIR=
XD_POSTGRES_DATA_DIR=
XD_CADDY_DATA_DIR=
XD_CADDY_CONFIG_DIR=

# Base registry for xDrive server and merged Caddy/Web images. Useful with a private or regional registry mirror.
# When switching to GitLab without an explicit override, the installer resolves the
# project's container_registry_image_prefix from the GitLab Project API.
XD_IMAGE_REGISTRY=ghcr.io/lazyxu
XD_POSTGRES_IMAGE=postgres:17-alpine
XD_SERVER_IMAGE=ghcr.io/lazyxu/xdrive-server:latest
XD_CADDY_IMAGE=ghcr.io/lazyxu/xdrive-caddy:latest
XD_PHOTO_FACE_IMAGE=ghcr.io/lazyxu/xdrive-photo-face:latest

# Optional public HTTPS via AliDNS DNS-01. Leave XD_DOMAIN empty for HTTP/private mode.
# Only XD_HTTPS_PORT (default 8443) must be reachable; ACME does not need inbound 80/443.
XD_DOMAIN=
XD_HTTPS_BIND=0.0.0.0
XD_HTTPS_PORT=8443
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Container resource limits.
XD_POSTGRES_MEMORY_LIMIT=1g
XD_POSTGRES_CPU_LIMIT=1.0
XD_POSTGRES_PIDS_LIMIT=256
XD_SERVER_MEMORY_LIMIT=1g
XD_SERVER_CPU_LIMIT=1.0
XD_SERVER_PIDS_LIMIT=256
XD_WORKER_MEMORY_LIMIT=512m
XD_WORKER_CPU_LIMIT=0.50
XD_WORKER_PIDS_LIMIT=128
XD_CADDY_MEMORY_LIMIT=256m
XD_CADDY_CPU_LIMIT=0.50
XD_CADDY_PIDS_LIMIT=128
XD_PHOTO_FACE_MEMORY_LIMIT=1g
XD_PHOTO_FACE_CPU_LIMIT=1.0
XD_PHOTO_FACE_PIDS_LIMIT=128

# Docker json-file log rotation.
XD_LOG_MAX_SIZE=10m
XD_LOG_MAX_FILES=5

# Backup policy used by install-server.sh when crontab is available.
XD_BACKUP_RETENTION_DAYS=7
XD_BACKUP_SCHEDULE="17 3 * * *"
