# xDrive server environment. The installer writes the active file to ~/.xd/.env.
POSTGRES_PASSWORD=replace-with-random-value
XD_JWT_SECRET=replace-with-a-long-random-value
XD_WEB_BIND=0.0.0.0
XD_WEB_PORT=3000
XD_ALLOWED_ORIGIN=http://localhost:3000
XD_MAX_UPLOAD_BYTES=21474836480
XD_SERVER_IMAGE=ghcr.io/lazyxu/xdrive-server:latest
XD_WEB_IMAGE=ghcr.io/lazyxu/xdrive-web:latest
